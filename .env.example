# Nexconn Console -> Key Management (https://console.nexconn.ai/agile/apps/km)
# Leave empty to run in local mock mode (no Nexconn connection).
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
# Data center of your app: SG (default), NA or SA
NEXCONN_AREA=SG

PORT=8787
# Seconds a claimer has to pay before the next person in line gets the item
HOLD_SECONDS=300
MAX_WAITLIST=5
DATA_DIR=./data

# Admin key for GET /api/admin/stats (header x-admin-key)
ADMIN_KEY=

# ClaimIt Pro billing (optional). Dodo Payments checkout links and webhook signing secret; use test-mode values first.
DODO_PRO_LINK=
DODO_PRO_LINK_FOUNDING=
DODO_WEBHOOK_SECRET=
# Set to 1 when the Dodo products are monthly subscriptions
DODO_PRO_RECURRING=
# Fallback without Dodo: your own payment link and the note buyers of Pro should add
PRO_PAY_LINK=
PRO_PAY_NOTE=
